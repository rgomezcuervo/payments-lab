# Copia a `.env` para desarrollo local. No commitear secretos (solo claves públicas / IDs de sitio).

# POST JSON: { name, email, message, recaptchaToken? } — el backend debe verificar el token con la clave secreta de Google.
VITE_CONTACT_FORM_ENDPOINT=

# reCAPTCHA v3 — site key pública (la clave secreta vive solo en el servidor).
VITE_RECAPTCHA_SITE_KEY=

# Google Tag Manager — contenedor público (GTM-XXXX).
VITE_GTM_CONTAINER_ID=

# Microsoft Clarity — project ID (el tenant puede desactivar Clarity en su JSON con `"observability": { "clarity": false }`).
VITE_CLARITY_PROJECT_ID=

# Datadog RUM — solo claves públicas; en `npm run dev` / tests no se inicializa salvo VITE_DATADOG_ALLOW_IN_DEV=true.
VITE_DATADOG_APPLICATION_ID=
VITE_DATADOG_CLIENT_TOKEN=
VITE_DATADOG_SERVICE=landing-recaudos
VITE_DATADOG_ENV=development
# datadoghq.com | datadoghq.eu | us3.datadoghq.com | etc.
VITE_DATADOG_SITE=datadoghq.com
# true = permitir init del SDK en desarrollo (p. ej. clave de prueba)
VITE_DATADOG_ALLOW_IN_DEV=
